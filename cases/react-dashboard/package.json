    "@tailwindcss/webpack": "4.3.3",
    "@types/lodash-es": "4.17.12",
    "@utoo/pack": "1.5.34",
    "html-webpack-plugin": "5.6.8",
    "tailwindcss": "4.3.3"
  },
  "browserslist": [
    "Chrome >= 111"
  ]
